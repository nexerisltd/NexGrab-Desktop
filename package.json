{
  "name": "nexgrab",
  "productName": "NexGrab",
  "version": "2.1.0",
  "description": "NexGrab — a beautifully simple, ridiculously capable YouTube video & audio downloader powered by yt-dlp.",
  "author": "NexApp",
  "main": "main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.nexapp.nexgrab",
    "productName": "NexGrab",
    "forceCodeSigning": false,
    "asar": true,
    "compression": "maximum",
    "icon": "assets/icon.png",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/icon.*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "forceCodeSigning": false,
      "artifactName": "NexGrab-Setup-${version}-win64.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NexGrab",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerSidebar": "assets/installer-sidebar.bmp",
      "uninstallerSidebar": "assets/installer-sidebar.bmp",
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  }
}
